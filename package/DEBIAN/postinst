#!/bin/bash

set -e

VERSION="V4_10_0_rev0"
FILE="CoppeliaSim_Edu_${VERSION}_Ubuntu24_04.tar.xz"

case "$1" in
  configure)
    # -c resumes a download interrupted by a previous failed run
    wget -c -q --show-progress "https://downloads.coppeliarobotics.com/${VERSION}/${FILE}" -O "/tmp/${FILE}"
    rm -rf /opt/coppelia-sim-edu
    mkdir /opt/coppelia-sim-edu
    tar -xf "/tmp/${FILE}" -C /opt/coppelia-sim-edu --strip-components=1
    rm "/tmp/${FILE}"
    ;&
  triggered) # mrs_msgs got updated, see triggers
    coppelia-sim-build-ros2-plugin || echo "Building the simROS2 plugin failed, rerun 'sudo coppelia-sim-build-ros2-plugin'"
    ;;
esac
